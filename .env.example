# Copy this file to ".env" and paste your own keys there.


# Google AI Studio (Gemini)
GEMINI_API_KEY=

# Groq
GROQ_API_KEY=

# Optional: model IDs (defaults are set in the code; uncomment to override)
# GEMINI_MODEL=gemini-3.1-flash-lite
# GROQ_MODEL=openai/gpt-oss-20b

# Tavily (web search)
TAVILY_API_KEY=

# LangSmith (tracing)
LANGSMITH_API_KEY=

# Signs login tokens. Generate your own with: openssl rand -hex 32
JWT_SECRET=

# Optional tracing (sends report text to LangSmith's cloud: fictional data only)
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=community-voice
